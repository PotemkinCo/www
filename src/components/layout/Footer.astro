---
import { withBase } from "@/utils/path";
---

<footer class="site-footer">
	<div class="right">
		<a href={withBase("/tags/")}>Tags</a>
		<span class="sep" aria-hidden="true">·</span>
		<a href={withBase("/rss.xml")}>RSS</a>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline);
		padding-top: 22px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 16px;
		font-family: var(--font-sans);
		font-size: 12.5px;
		color: hsl(var(--theme-text) / 0.72);
		transition: border-color 0.35s ease;
	}
	.site-footer .right {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.site-footer .right .sep {
		color: var(--faint);
	}
	.site-footer a {
		color: hsl(var(--theme-text-muted));
		transition: color 0.2s ease;
	}
	.site-footer a:hover {
		color: hsl(var(--theme-accent));
	}

	@media (max-width: 420px) {
		.site-footer {
			font-size: 11.5px;
			gap: 12px;
		}
	}
</style>
